@model wt_lab4_4mvc_marfel.Models.ProjectTask

@{
    ViewData["Title"] = "Детали задачи";
}

<h1>Детали задачи</h1>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">@Model.Title</h5>
        <p class="card-text">
            <strong>Исполнитель:</strong> @Model.Assignee<br />
            <strong>Приоритет:</strong> @Model.Priority<br />
            <strong>Статус:</strong>
            @if (Model.IsCompleted)
            {
                    <span class="badge bg-success">Выполнена</span>
            }
            else
            {
                    <span class="badge bg-warning text-dark">В работе</span>
            }
        </p>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Редактировать</a>
        <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
    </div>
</div>